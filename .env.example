# Локальный Supabase LeadBombing (supabase/config.toml, порты 5532x).
# Скопируйте в .env.local; ключ печатает `npx supabase status` (PUBLISHABLE_KEY или ANON_KEY).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
# Необязательно: ключ подписи cookie сессии. Без него создаётся в папке настроек LeadBombing.
# LEADBOMBING_SECRET_KEY=
